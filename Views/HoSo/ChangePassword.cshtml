@model DuyBarberShop.ViewModels.DoiMatKhauViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="account-shell"><div class="account-wrap"><div class="account-panel"><aside class="account-aside"><div class="account-logo">DUY<span style="color:#ffe0d5">BARBER</span></div><div><h2>Bảo mật tài khoản của bạn</h2><p>Thường xuyên cập nhật mật khẩu để bảo vệ thông tin cá nhân và lịch hẹn.</p></div><small>DUY BARBER SHOP · Phong cách của bạn, sự tận tâm của chúng tôi.</small></aside><section class="account-main"><div class="account-eyebrow">Tài khoản khách hàng</div><h1>Đổi mật khẩu</h1><p class="account-lead">Bảo vệ tài khoản bằng mật khẩu an toàn.</p>@if (TempData["Success"] != null) {
    <div class="account-notice">@TempData["Success"]</div>
}
<form asp-controller="HoSo" asp-action="ChangePassword" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="account-error"></div><div class="account-field"><label asp-for="MatKhauHienTai"></label><div class="account-password"><input asp-for="MatKhauHienTai" class="account-input" placeholder="Nhập mật khẩu hiện tại" type="password" /><button type="button" class="account-eye" data-target="MatKhauHienTai" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="MatKhauHienTai" class="account-error"></span></div><div class="account-field"><label asp-for="MatKhauMoi"></label><div class="account-password"><input asp-for="MatKhauMoi" class="account-input" placeholder="Nhập mật khẩu mới" type="password" /><button type="button" class="account-eye" data-target="MatKhauMoi" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="MatKhauMoi" class="account-error"></span></div><div class="account-field"><label asp-for="XacNhanMatKhau"></label><div class="account-password"><input asp-for="XacNhanMatKhau" class="account-input" placeholder="Nhập lại mật khẩu mới" type="password" /><button type="button" class="account-eye" data-target="XacNhanMatKhau" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="XacNhanMatKhau" class="account-error"></span></div><div class="account-actions"><button type="submit" class="account-btn">Đổi mật khẩu</button><a asp-controller="HoSo" asp-action="Index" class="account-btn account-btn-outline">Quay lại hồ sơ</a></div></form></section></div></div></div>
<script>
    document.querySelectorAll('.account-eye').forEach(function(button) { button.addEventListener('click', function() { var input = document.getElementById(button.getAttribute('data-target')); if (!input) return; var shown = input.type === 'text'; input.type = shown ? 'password' : 'text'; button.textContent = shown ? 'Hiện' : 'Ẩn'; button.setAttribute('aria-label', shown ? 'Hiện mật khẩu' : 'Ẩn mật khẩu'); }); });
</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/shared/account-forms.css" asp-append-version="true" />
}
