<script>
    (() => {
        const carousel = document.getElementById('duyCarousel');
        if (!carousel) return;
        const slides = [...carousel.querySelectorAll('.duy-slide')];
        const dots = [...carousel.querySelectorAll('.duy-dot')];
        let current = 0;
        let timer;
        function show(index) {
            current = (index + slides.length) % slides.length;
            slides.forEach((slide, i) => {
                const active = i === current;
                slide.classList.toggle('is-active', active);
                slide.setAttribute('aria-hidden', String(!active));
                slide.querySelectorAll('a').forEach(a => a.tabIndex = active ? 0 : -1);
                dots[i].classList.toggle('is-active', active);
                if (active) dots[i].setAttribute('aria-current', 'true');
                else dots[i].removeAttribute('aria-current');
            });
        }
        function stop() { clearInterval(timer); }
        function start() {
            stop();
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            timer = setInterval(() => show(current + 1), 5000);
        }
        function move(delta) { show(current + delta); start(); }
        carousel.querySelector('.duy-prev').addEventListener('click', () => move(-1));
        carousel.querySelector('.duy-next').addEventListener('click', () => move(1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
        let touchStartX = null;
        carousel.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
        carousel.addEventListener('touchend', e => {
            if (touchStartX === null) return;
            const distance = e.changedTouches[0].screenX - touchStartX;
            if (Math.abs(distance) > 45) move(distance < 0 ? 1 : -1);
            touchStartX = null;
        }, { passive: true });
        carousel.addEventListener('mouseenter', stop);
        carousel.addEventListener('mouseleave', start);
        carousel.addEventListener('focusin', stop);
        carousel.addEventListener('focusout', e => { if (!carousel.contains(e.relatedTarget)) start(); });
        document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
        show(0); start();
    })();
</script>

<script>
    (() => {
        const root = document.getElementById('duyHairCarousel');
        if (!root) return;
        const slides = Array.from(root.querySelectorAll('.duy-hair-slide'));
        const dots = Array.from(root.querySelectorAll('.duy-hair-dot'));
        let current = 0, timer;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        function show(index) {
            current = (index + slides.length) % slides.length;
            slides.forEach((slide, i) => {
                const active = i === current;
                slide.classList.toggle('is-active', active);
                slide.setAttribute('aria-hidden', String(!active));
                slide.querySelectorAll('a').forEach(link => link.tabIndex = active ? 0 : -1);
                dots[i].classList.toggle('is-active', active);
                if (active) dots[i].setAttribute('aria-current', 'true');
                else dots[i].removeAttribute('aria-current');
            });
        }
        function stop() { clearInterval(timer); }
        function start() {
            stop();
            if (!document.hidden && !reduced.matches) timer = setInterval(() => show(current + 1), 5000);
        }
        function move(delta) { show(current + delta); start(); }
        root.querySelector('.duy-hair-prev').addEventListener('click', () => move(-1));
        root.querySelector('.duy-hair-next').addEventListener('click', () => move(1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
        let startX = null;
        root.addEventListener('touchstart', e => { startX = e.changedTouches[0].screenX; }, { passive:true });
        root.addEventListener('touchend', e => {
            if (startX === null) return;
            const distance = e.changedTouches[0].screenX - startX;
            if (Math.abs(distance) > 45) move(distance < 0 ? 1 : -1);
            startX = null;
        }, { passive:true });
        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', stop);
        root.addEventListener('focusout', e => { if (!root.contains(e.relatedTarget)) start(); });
        document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
        show(0); start();
    })();
</script>

