@model DuyBarberShop.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="account-shell"><div class="account-wrap"><div class="account-panel"><aside class="account-aside"><div class="account-logo">DUY<span style="color:#ffe0d5">BARBER</span></div><div><h2>Tự tin với diện mạo mới</h2><p>Đăng nhập để theo dõi lịch hẹn và trải nghiệm dịch vụ tại DuyBarber.</p></div><small>DUY BARBER SHOP · Phong cách của bạn, sự tận tâm của chúng tôi.</small></aside><section class="account-main"><div class="account-eyebrow">Tài khoản khách hàng</div><h1>Đăng nhập</h1><p class="account-lead">Rất vui được đón tiếp bạn trở lại.</p>@if (TempData["SuccessMessage"] != null) {
    <div class="account-notice">@TempData["SuccessMessage"]</div>
}
<form asp-controller="TaiKhoan" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="account-error"></div><div class="account-field"><label asp-for="Email"></label><input asp-for="Email" class="account-input" placeholder="Nhập địa chỉ email" /><span asp-validation-for="Email" class="account-error"></span></div><div class="account-field"><label asp-for="MatKhau"></label><div class="account-password"><input asp-for="MatKhau" class="account-input" placeholder="Nhập mật khẩu" type="password" /><button type="button" class="account-eye" data-target="MatKhau" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="MatKhau" class="account-error"></span></div><div class="account-field"><label class="account-check"><input asp-for="GhiNhoDangNhap" /> Ghi nhớ đăng nhập</label></div><button class="account-btn account-btn-full" type="submit">Đăng nhập</button></form><p class="account-foot">Chưa có tài khoản? <a asp-controller="TaiKhoan" asp-action="Register">Đăng ký ngay</a></p></section></div></div></div>
<script>
    document.querySelectorAll('.account-eye').forEach(function(button) { button.addEventListener('click', function() { var input = document.getElementById(button.getAttribute('data-target')); if (!input) return; var shown = input.type === 'text'; input.type = shown ? 'password' : 'text'; button.textContent = shown ? 'Hiện' : 'Ẩn'; button.setAttribute('aria-label', shown ? 'Hiện mật khẩu' : 'Ẩn mật khẩu'); }); });
</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/shared/account-forms.css" asp-append-version="true" />
}
