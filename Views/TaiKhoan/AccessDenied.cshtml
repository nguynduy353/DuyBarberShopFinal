@{
    ViewData["Title"] = "Không có quyền truy cập";
}



<main class="db-access-page">
    <section class="db-access-card" aria-labelledby="db-access-heading">
        <div class="db-access-symbol" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                <rect x="9" y="10" width="6" height="5" rx="1" />
                <path d="M10 10V8a2 2 0 0 1 4 0v2" />
            </svg>
        </div>

        <p class="db-access-code">403</p>
        <h1 id="db-access-heading" class="db-access-title">Không có quyền truy cập</h1>
        <p class="db-access-description">
            Tài khoản của bạn không có quyền truy cập trang này.
            Vui lòng quay về trang chủ hoặc sử dụng tài khoản có quyền phù hợp.
        </p>

        <a asp-controller="TrangChu" asp-action="Index" class="db-access-home">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m3 10 9-7 9 7" />
                <path d="M5 9v12h14V9" />
                <path d="M9 21v-7h6v7" />
            </svg>
            Về trang chủ
        </a>
    </section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/views/TaiKhoan/AccessDenied.css" asp-append-version="true" />
}
